<script>
	// The hero ("Hello, I'm" / name / headline) streams in a few characters at a time, like an LLM reply,
	// with a cursor that follows the newest text. The full text stays in the DOM (SEO, screen readers, print).
	const root = document.documentElement;
	const targets = [...document.querySelectorAll<HTMLElement>('.hero .label, .hero h1, .hero .sub')];
	if (!targets.length || matchMedia('(prefers-reduced-motion: reduce)').matches) {
		root.classList.add('ready');
	} else {
		const items = targets.map((el) => {
			const text = (el.textContent ?? '').trim();
			const on = document.createElement('span');
			const rest = document.createElement('span');
			rest.className = 'rest'; // not yet streamed: invisible but keeps the layout stable
			rest.textContent = text;
			el.textContent = '';
			el.append(on, rest);
			return { el, on, rest, text };
		});
		const cur = document.createElement('span');
		cur.className = 'cur';
		let i = 0, n = 0, stopped = false;
		const render = (it: (typeof items)[number], upTo: number) => {
			it.on.textContent = it.text.slice(0, upTo);
			it.rest.textContent = it.text.slice(upTo);
		};
		const step = () => {
			if (stopped) return;
			const it = items[i];
			if (!it) { setTimeout(() => cur.remove(), 2500); return; }
			if (n === 0) it.el.insertBefore(cur, it.rest);
			n = Math.min(it.text.length, n + 1 + Math.floor(Math.random() * 3)); // 1-3 characters per chunk
			render(it, n);
			let delay = 70 + Math.random() * 80;
			if (/[.,&]/.test(it.text[n - 1] ?? '')) delay += 140;
			if (n >= it.text.length) { i++; n = 0; delay += 420; }
			setTimeout(step, delay);
		};
		root.classList.add('ready');
		setTimeout(step, 500);
		addEventListener('beforeprint', () => {
			stopped = true;
			items.forEach((it) => render(it, it.text.length));
			cur.remove();
		});
	}
</script>
