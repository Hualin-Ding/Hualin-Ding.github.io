---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import DotField from '../components/DotField.astro';

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#282828" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
		<title>{title}</title>
		<script is:inline>
			document.documentElement.classList.add('js');
			setTimeout(() => document.documentElement.classList.add('ready'), 1500);
		</script>
	</head>
	<body>
		<DotField />
		<slot />
	</body>
</html>

<style is:global>
/* Palette from ~/.config/ghostty/config. Only three text colors: fg, muted, accent. */
:root{--bg:#282828;--bg1:#3c3836;--fg:#ebdbb2;--mute:#a89984;--dim:#928374;--acc:#fabd2f;--sel:#504945}
*{box-sizing:border-box}html{background:var(--bg);scroll-behavior:smooth}
body{margin:0;color:var(--fg);background:rgba(40,40,40,.95);font:15px/1.75 'JetBrainsMono Nerd Font','JetBrains Mono','SF Mono',ui-monospace,Menlo,monospace;font-feature-settings:"calt","liga"}
::selection{background:var(--sel)}canvas{position:fixed;inset:0;z-index:0}
.page{position:relative;z-index:1;max-width:760px;margin:0 auto;padding:0 24px}
nav{display:flex;justify-content:space-between;padding:28px 0;color:var(--dim);font-size:.85rem}
nav a{color:var(--dim);text-decoration:none;margin-left:24px}nav a:hover{color:var(--acc)}
header{padding:clamp(24px,6vh,64px) 0 clamp(36px,6vh,64px)}.label{color:var(--acc);font-size:.9rem}
h1{font-size:clamp(2.6rem,8vw,4.4rem);line-height:1.05;margin:.6rem 0 1.2rem;font-weight:700;letter-spacing:-.03em}
.sub{color:var(--mute);font-size:1.1rem;max-width:34rem;margin:0}
.cta{margin-top:2rem}.cta a{color:var(--fg);text-decoration:none;border-bottom:1px solid var(--acc);margin-right:1.6rem;padding-bottom:2px}.cta a:hover{color:var(--acc)}
section{padding:0 0 clamp(36px,5vh,56px)}h2{font-size:.85rem;font-weight:400;color:var(--dim);margin:0 0 1.4rem;display:flex;gap:1rem;align-items:center}h2::after{content:"";flex:1;height:1px;background:var(--bg1)}h2 i{font-style:normal;color:var(--acc)}
p{margin:0 0 1rem;color:var(--mute)}p b{color:var(--fg);font-weight:500}
.list{border-top:1px solid var(--bg1)}.row{display:grid;grid-template-columns:130px 1fr;gap:20px;padding:16px 0;border-bottom:1px solid var(--bg1);transition:background .2s,padding .2s}
.row:hover{background:rgba(60,56,54,.5);padding-left:10px}.row time{color:var(--dim);font-size:.85rem;padding-top:.15rem}.row h3{margin:0;font-size:1rem;font-weight:500}.row span{color:var(--mute);font-size:.9rem;display:block}
.tags{color:var(--mute)}.tags span:not(:last-child)::after{content:"·";margin:0 .6em;color:var(--dim)}.row .tags span{display:inline-block;font-size:.95rem;color:var(--fg);white-space:nowrap}
footer{padding:0 0 clamp(40px,8vh,80px);color:var(--dim);font-size:.85rem;text-align:center}footer p{margin:0 0 .6rem}footer .copy{color:var(--dim);font-size:.8rem}footer a{color:var(--mute)}footer a:hover{color:var(--acc)}
.row{position:relative}.has-pop:focus-visible{outline:1px solid var(--acc);outline-offset:2px}
.pop{position:absolute;left:150px;right:0;top:calc(100% - 4px);z-index:20;background:#1d2021;border:1px solid var(--bg1);border-radius:8px;padding:14px 18px;box-shadow:0 12px 32px rgba(0,0,0,.45);opacity:0;visibility:hidden;transform:translateY(-6px);transition:opacity .18s,transform .18s,visibility .18s;pointer-events:none}
.pop ul{margin:0;padding-left:1.1rem;color:var(--mute);font-size:.88rem;line-height:1.6}.pop li{margin:.3rem 0}.pop li::marker{color:var(--acc)}.pop li b{color:var(--fg);font-weight:500}
.has-pop:hover .pop,.has-pop:focus-visible .pop{opacity:1;visibility:visible;transform:none}
@media(hover:none){.pop{position:static;grid-column:1/-1;opacity:1;visibility:visible;transform:none;box-shadow:none;background:none;border:0;padding:8px 0 0;pointer-events:auto;display:none}.has-pop.open .pop{display:block}.has-pop{cursor:pointer}.has-pop h3::after{content:" +";color:var(--acc)}.has-pop.open h3::after{content:" −"}}
@media(max-width:600px){.row{grid-template-columns:1fr;gap:2px}.pop{left:0}}
.linkbtn,footer a{display:inline-flex;align-items:center;gap:.45rem;font:inherit;color:var(--mute);background:none;border:0;padding:0;cursor:pointer;text-decoration:none}.linkbtn:hover,footer a:hover{color:var(--acc)}footer .lbl{text-decoration:underline;text-underline-offset:3px}.ico{width:1.15em;height:1.15em;fill:currentColor;flex:none}footer .links{display:flex;justify-content:center;flex-wrap:wrap;gap:.6rem 1.8rem}
.hero{display:flex;gap:28px;align-items:center}.avatar{width:112px;height:112px;border-radius:50%;object-fit:cover;flex:none;box-shadow:0 0 0 2px var(--acc),0 0 0 7px rgba(250,189,47,.12);filter:sepia(.3) saturate(.85) contrast(1.03);transition:filter .3s}.avatar:hover{filter:none}
@media(max-width:600px){.hero{flex-direction:column;align-items:flex-start;gap:20px}}
.js:not(.ready) .hero .label,.js:not(.ready) .hero h1,.js:not(.ready) .hero .sub{visibility:hidden}.rest{visibility:hidden}
.cur{position:relative;display:inline-block;width:0;height:1em}.cur::after{content:"";position:absolute;left:0;bottom:-.18em;width:.55em;height:1.05em;background:var(--acc);animation:blink 1s steps(1) infinite}@keyframes blink{50%{opacity:0}}@media(prefers-reduced-motion:reduce){.cur::after{animation:none}}
.trace{border:1px solid var(--bg1);background:rgba(29,32,33,.7);border-radius:8px;padding:12px 16px;margin:0 0 1.6rem;font-size:.78rem;line-height:1.75}
.trace-head{display:flex;justify-content:space-between;gap:12px;color:var(--dim);margin-bottom:6px}.trace-body{min-height:calc(6*1.75em)}
.tr{display:grid;grid-template-columns:62px 82px 1fr;gap:12px}.tr .t{color:var(--dim)}.tr .s{color:var(--acc)}.tr .m{color:var(--mute)}.tr .tcur{color:var(--acc);animation:blink 1s steps(1) infinite}
@media(max-width:600px){.tr{grid-template-columns:78px 1fr}.tr .t{display:none}.trace-body{min-height:calc(9*1.75em)}}
.pr{display:none}
.more>summary{list-style:none;cursor:pointer;display:grid}.more>summary::-webkit-details-marker{display:none}.more>summary time{color:var(--acc)}.more>summary .hint{color:var(--dim);font-size:.85rem}.more:not([open]) .c,.more[open] .o{display:none}.more[open] .hint{display:none}.more>summary:focus-visible{outline:1px solid var(--acc);outline-offset:2px}
.print-only{display:none}
@media print{
.fn{display:none}.pr{display:inline}
.rest{visibility:visible!important}.cur,.trace{display:none!important}
@page{size:Letter;margin:.5in .55in .6in;@bottom-right{content:"Hualin Ding · " counter(page) " / " counter(pages);font:7.5pt "JetBrains Mono",monospace;color:#8a8070}}
*{-webkit-print-color-adjust:exact;print-color-adjust:exact}
:root{--fg:#1d1d1b;--mute:#4a4a46;--dim:#6b665c;--acc:#9a6700;--bg1:#e8e1d3}
html,body{background:#fff!important;color:#1d1d1b;font:9.5pt/1.45 "Helvetica Neue",Helvetica,Arial,sans-serif}
canvas,nav,.cta,.label,.avatar,#work,#contact,footer,section h2 i{display:none!important}
.print-only{display:block}
.page{max-width:none;padding:0}
header{background:#282828;color:#ebdbb2;border-radius:6px;padding:16px 22px 14px;margin:0 0 16px}
.hero{display:block}
h1{font:700 27pt/1.05 "Helvetica Neue",Helvetica,Arial,sans-serif;letter-spacing:-.01em;color:#ebdbb2;margin:0 0 5px}
.sub{font-size:10.5pt;color:#fabd2f;margin:0 0 8px;max-width:none}
.contact{margin:0;font:8.5pt "JetBrains Mono",monospace;color:#d5c4a1}.contact a{color:#ebdbb2;text-decoration:none}
section{padding:0 0 12px}
h2{font:700 8.5pt "JetBrains Mono",monospace;color:#9a6700;text-transform:uppercase;letter-spacing:.18em;margin:0 0 6px;break-after:avoid}h2::after{background:#d9d0c0}
a{color:inherit;text-decoration:none}
p{color:#2b2b28;margin:0 0 6px}p b{color:#111}
.list{border-top:0}
.row{padding:6px 0!important;background:none!important;break-inside:avoid;border-bottom:1px solid #e8e1d3;grid-template-columns:112px 1fr;gap:0 14px}
.row time{font:8pt "JetBrains Mono",monospace;color:#9a6700;letter-spacing:.04em;padding-top:2px}
.row h3{font:700 10.5pt "Helvetica Neue",Helvetica,Arial,sans-serif;color:#111;break-after:avoid}
.row span{font-size:9.5pt;color:#4a4a46}.row h3+span{font-style:italic}
.has-pop h3::after{content:none!important}
.row.has-pop>div{break-after:avoid}.row.has-pop .pop{break-before:avoid}.row.has-pop{display:block;position:relative;padding-left:126px!important;break-inside:auto}.row.has-pop>time{position:absolute;left:0;top:8px}
.pop{display:block!important;position:static;opacity:1;visibility:visible;transform:none;box-shadow:none;background:none;border:0;padding:4px 0 0;pointer-events:auto}
.pop ul{margin:0;padding-left:1rem;font-size:9.3pt;color:#2b2b28;line-height:1.42}.pop li{margin:2px 0;break-inside:avoid}.pop li::marker{color:#9a6700}.pop li b{color:#111;font-weight:700}
#tools .more>summary{display:none!important}
#tools .row time{text-transform:uppercase;letter-spacing:.08em;font-size:7.5pt}
#tools .list>.row:nth-child(-n+3) time{font-weight:700}#tools .list>.row:nth-child(-n+3) .tags span{font-weight:600;color:#111}
.tags{color:#2b2b28}.tags span:not(:last-child)::after{content:"·";margin:0 .55em;color:#c4a24a}
#tools .row .tags span{display:inline-block;font-size:9.3pt}
#certs time{visibility:hidden}
}
</style>
