---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import DotField from '../components/DotField.astro';

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#282828" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
	</head>
	<body>
		<DotField />
		<slot />
	</body>
</html>

<style is:global>
/* Palette from ~/.config/ghostty/config. Only three text colors: fg, muted, accent. */
:root{--bg:#282828;--bg1:#3c3836;--fg:#ebdbb2;--mute:#a89984;--dim:#928374;--acc:#fabd2f;--sel:#504945}
*{box-sizing:border-box}html{background:var(--bg);scroll-behavior:smooth}
body{margin:0;color:var(--fg);background:rgba(40,40,40,.95);font:15px/1.75 'JetBrainsMono Nerd Font','JetBrains Mono','SF Mono',ui-monospace,Menlo,monospace;font-feature-settings:"calt","liga"}
::selection{background:var(--sel)}canvas{position:fixed;inset:0;z-index:0}
.page{position:relative;z-index:1;max-width:760px;margin:0 auto;padding:0 24px}
nav{display:flex;justify-content:space-between;padding:28px 0;color:var(--dim);font-size:.85rem}
nav a{color:var(--dim);text-decoration:none;margin-left:24px}nav a:hover{color:var(--acc)}
header{padding:14vh 0 10vh}.label{color:var(--acc);font-size:.9rem}
h1{font-size:clamp(2.6rem,8vw,4.4rem);line-height:1.05;margin:.6rem 0 1.2rem;font-weight:700;letter-spacing:-.03em}
.sub{color:var(--mute);font-size:1.1rem;max-width:34rem;margin:0}
.cta{margin-top:2rem}.cta a{color:var(--fg);text-decoration:none;border-bottom:1px solid var(--acc);margin-right:1.6rem;padding-bottom:2px}.cta a:hover{color:var(--acc)}
section{padding:0 0 8vh}h2{font-size:.85rem;font-weight:400;color:var(--dim);margin:0 0 1.4rem;display:flex;gap:1rem;align-items:center}h2::after{content:"";flex:1;height:1px;background:var(--bg1)}h2 i{font-style:normal;color:var(--acc)}
p{margin:0 0 1rem;color:var(--mute)}p b{color:var(--fg);font-weight:500}
.list{border-top:1px solid var(--bg1)}.row{display:grid;grid-template-columns:130px 1fr;gap:20px;padding:16px 0;border-bottom:1px solid var(--bg1);transition:background .2s,padding .2s}
.row:hover{background:rgba(60,56,54,.5);padding-left:10px}.row time{color:var(--dim);font-size:.85rem;padding-top:.15rem}.row h3{margin:0;font-size:1rem;font-weight:500}.row span{color:var(--mute);font-size:.9rem;display:block}
.tags{color:var(--mute)}.tags span:not(:last-child)::after{content:"  ·  ";color:var(--dim)}
footer{padding:0 0 12vh;color:var(--dim);font-size:.85rem;text-align:center}footer p{margin:0 0 .6rem}footer .copy{color:var(--dim);font-size:.8rem}footer a{color:var(--mute)}footer a:hover{color:var(--acc)}
.row{position:relative}.has-pop:focus-visible{outline:1px solid var(--acc);outline-offset:2px}
.pop{position:absolute;left:150px;right:0;top:calc(100% - 4px);z-index:20;background:#1d2021;border:1px solid var(--bg1);border-radius:8px;padding:14px 18px;box-shadow:0 12px 32px rgba(0,0,0,.45);opacity:0;visibility:hidden;transform:translateY(-6px);transition:opacity .18s,transform .18s,visibility .18s;pointer-events:none}
.pop ul{margin:0;padding-left:1.1rem;color:var(--mute);font-size:.88rem;line-height:1.6}.pop li{margin:.3rem 0}.pop li::marker{color:var(--acc)}
.has-pop:hover .pop,.has-pop:focus-visible .pop{opacity:1;visibility:visible;transform:none}
@media(hover:none){.pop{position:static;grid-column:1/-1;opacity:1;visibility:visible;transform:none;box-shadow:none;background:none;border:0;padding:8px 0 0;pointer-events:auto}}
@media(max-width:600px){.row{grid-template-columns:1fr;gap:2px}.pop{left:0}}
.linkbtn{font:inherit;color:var(--mute);background:none;border:0;padding:0;cursor:pointer;text-decoration:underline}.linkbtn:hover{color:var(--acc)}
.hero{display:flex;gap:28px;align-items:center}.avatar{width:112px;height:112px;border-radius:50%;object-fit:cover;flex:none;box-shadow:0 0 0 2px var(--acc),0 0 0 7px rgba(250,189,47,.12);filter:sepia(.3) saturate(.85) contrast(1.03);transition:filter .3s}.avatar:hover{filter:none}
@media(max-width:600px){.hero{flex-direction:column;align-items:flex-start;gap:20px}}
.print-only{display:none}
@media print{
@page{size:Letter;margin:.45in}
:root{--fg:#111;--mute:#333;--dim:#555;--acc:#555;--bg1:#cfcbc2}
html,body{background:#fff!important;color:#111;font-size:9.5pt;line-height:1.35}
canvas,nav,.cta,.label,.avatar,#work,#about,#contact,footer,section h2 i{display:none!important}
.print-only{display:block}
.page{max-width:none;padding:0}
header{padding:0 0 8px;border-bottom:1.5px solid #111;margin-bottom:10px}
h1{font-size:22pt;margin:0 0 2px;letter-spacing:0}
.sub{font-size:10.5pt;color:#333;margin:0 0 6px;max-width:none}
.contact{margin:0;font-size:9.5pt;color:#333}.contact a{color:#111;text-decoration:none}
section{padding:0 0 5px}
h2{font-size:9.5pt;font-weight:700;color:#111;text-transform:uppercase;letter-spacing:.12em;margin:0 0 4px}h2::after{background:#999}
a{color:#111;text-decoration:none}.row h3 a{border:0}
p{color:#222;margin:0 0 6px}p b{color:#111}
.list{border-top:1px solid #999}
.row{padding:4px 0!important;background:none!important;break-inside:avoid;border-bottom:1px solid #ddd;grid-template-columns:82px 1fr;gap:0 12px}
.row time{font-size:9pt;color:#444}.row h3{font-size:10.5pt;color:#111}.row span{font-size:9.5pt;color:#333}
.pop{position:static;grid-column:2;opacity:1;visibility:visible;transform:none;box-shadow:none;background:none;border:0;padding:4px 0 0;pointer-events:auto}
.pop li:nth-child(n+4){display:none}
.pop ul{font-size:9pt;color:#222;line-height:1.35;padding-left:1rem}.pop li{margin:1px 0}#certs .row span{display:none}#certs time{visibility:hidden}.pop li::marker{color:#111}
.tags{color:#222}.tags span:not(:last-child)::after{color:#777}
}
</style>
