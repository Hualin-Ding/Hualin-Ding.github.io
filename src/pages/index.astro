<script>
	// Touch devices have no hover: tap a path row to expand its details, tap another to switch, tap elsewhere to close all.
	const touch = matchMedia('(hover: none)');
	document.addEventListener('click', (e) => {
		if (!touch.matches) return;
		const row = (e.target as Element).closest('.has-pop');
		document.querySelectorAll('.has-pop.open').forEach((r) => { if (r !== row) r.classList.remove('open'); });
		row?.classList.toggle('open');
	});
	// "Resume (PDF)": open the print dialog (Save as PDF); the print stylesheet formats it as a resume.
	const base = document.title;
	addEventListener('beforeprint', () => { document.title = 'Hualin Ding - Resume'; });
	addEventListener('afterprint', () => { document.title = base; });
	// Email is never in the HTML. It is stored reversed + base64, split in pieces, and assembled only after a real user click (or when printing).
	const ENC = ["bW9jLmxp", "YW1nQGFx", "Z25pZGxo"];
	const addr = () => atob(ENC.join('')).split('').reverse().join('');
	document.getElementById('email-link')?.addEventListener('click', (e) => {
		if (!e.isTrusted) return;
		const a = addr(), lbl = (e.currentTarget as HTMLElement).querySelector('.lbl') as HTMLElement;
		// Copy too, for people without a mail app; the label confirms it.
		navigator.clipboard?.writeText(a).then(() => { lbl.textContent = 'email copied'; setTimeout(() => (lbl.textContent = 'email'), 2000); }).catch(() => {});
		location.href = 'mailto:' + a;
	});
	// Always print every row, even if "show more" is collapsed on screen.
	const dets = [...document.querySelectorAll('details')];
	let was: boolean[] = [];
	const openAll = () => { was = dets.map((d) => d.open); dets.forEach((d) => (d.open = true)); };
	const restore = () => dets.forEach((d, i) => (d.open = was[i] ?? false));
	addEventListener('beforeprint', openAll);
	addEventListener('afterprint', restore);
	matchMedia('print').addEventListener('change', (m) => (m.matches ? openAll() : restore()));
	const pe = document.getElementById('print-email');
	const fill = () => { if (pe) pe.textContent = addr() + ' · '; };
	const clear = () => { if (pe) pe.textContent = ''; };
	addEventListener('beforeprint', fill);
	addEventListener('afterprint', clear);
	matchMedia('print').addEventListener('change', (m) => (m.matches ? fill() : clear()));
	document.getElementById('pdf')?.addEventListener('click', (e) => { e.preventDefault(); print(); });
</script>
